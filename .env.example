# Скопируйте этот файл в .env и заполните значения.
# .env не коммитится в git (см. .gitignore) и не попадает в Docker-образ
# (см. .dockerignore).
#
# Сгенерировать надёжный SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   # или: openssl rand -hex 32

# --- PostgreSQL ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=theater
DB_USER=postgres
DB_PASSWORD=change-me

# --- JWT -----------------------------------------------------------------
SECRET_KEY=change-me-generate-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Клиент --------------------------------------------------------------
# Для эмулятора Android используйте http://10.0.2.2:8000
API_BASE_URL=http://localhost:8000

# --- Файлы ТЗ сценариев --------------------------------------------------
# Пусто = data/scenario_tz в корне проекта.
SCENARIO_TZ_UPLOAD_ROOT=
N8N_TZ_WEBHOOK_URL=
N8N_TZ_TIMEOUT_SEC=120
